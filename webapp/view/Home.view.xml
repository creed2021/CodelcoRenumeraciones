<mvc:View controllerName="codelco.portaldescuentos.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <Page id="homePage" showHeader="false">
        <content>
            <VBox id="homeContent" class="sapUiSmallMargin">

                <!-- ===== Encabezado del período ===== -->
                <OverflowToolbar id="tbHeader" style="Clear" height="auto">
                    <VBox id="vbTitulo">
                        <Title id="ttlPeriodo" text="Período {app>/periodo/texto}" level="H2" titleStyle="H3"/>
                        <Text id="txtSubtitulo" text="{app>/subtitulo}"/>
                    </VBox>
                    <ToolbarSpacer id="tbsHeader"/>
                    <Button id="btnPlantilla" text="Descargar plantilla" icon="sap-icon://download"
                        press=".onDescargarPlantilla"/>
                    <Button id="btnSubir" text="Subir archivo del período" icon="sap-icon://upload"
                        type="Emphasized"
                        enabled="{app>/puedeCargar}"
                        tooltip="{app>/motivoNoCarga}"
                        press=".onSubirArchivo"/>
                </OverflowToolbar>

                <MessageStrip id="msNoCarga"
                    text="{app>/motivoNoCarga}"
                    type="{= ${app>/periodo/abierto} ? 'Information' : 'Warning' }"
                    showIcon="true"
                    visible="{= !${app>/puedeCargar} &amp;&amp; !!${app>/motivoNoCarga} }"
                    class="sapUiSmallMarginTop"/>

                <!-- ===== Tarjetas ===== -->
                <l:Grid id="gridCards" defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMarginTop" containerQuery="true">

                    <!-- Estado del período -->
                    <f:Card id="cardPeriodo">
                        <f:header>
                            <card:Header id="hdrPeriodo" title="Estado del período" iconSrc="sap-icon://calendar"/>
                        </f:header>
                        <f:content>
                            <VBox id="vbPeriodo" class="sapUiSmallMargin">
                                <HBox id="hbEstado" alignItems="Center">
                                    <ObjectStatus id="osEstado" text="{app>/periodo/estadoTexto}"
                                        state="{app>/periodo/estadoState}" inverted="true"/>
                                    <Text id="txtDias" class="sapUiSmallMarginBegin"
                                        text="Quedan {app>/periodo/diasRestantes} días para cerrar"
                                        visible="{= !!${app>/periodo/abierto} }"/>
                                    <Text id="txtVencido" class="sapUiSmallMarginBegin"
                                        text="Venció el {app>/periodo/cierre}"
                                        visible="{= !${app>/periodo/abierto} }"/>
                                </HBox>
                                <ProgressIndicator id="piPeriodo" class="sapUiSmallMarginTop"
                                    percentValue="{app>/periodo/avance}"
                                    displayValue="{app>/periodo/apertura} → {app>/periodo/cierre}"
                                    state="{= ${app>/periodo/abierto} ? 'Success' : 'Error' }"/>
                                <Text id="txtRegla" class="sapUiTinyMarginTop"
                                    text="Solo se admite un archivo por período. Los registros rechazados deben informarse en la carga del mes siguiente."/>
                            </VBox>
                        </f:content>
                    </f:Card>

                    <!-- Su archivo de este período -->
                    <f:Card id="cardArchivo">
                        <f:header>
                            <card:Header id="hdrArchivo" title="Su archivo de este período" iconSrc="sap-icon://excel-attachment"/>
                        </f:header>
                        <f:content>
                            <VBox id="vbArchivo" class="sapUiSmallMargin">
                                <!-- Sin carga -->
                                <VBox id="vbSinArchivo" visible="{= !${app>/cargaActual} }" alignItems="Center">
                                    <core:Icon id="icoSinArchivo" src="sap-icon://document" size="2rem" color="Neutral"/>
                                    <Text id="txtSinArchivo" class="sapUiTinyMarginTop"
                                        text="Aún no envió su archivo para este período."/>
                                </VBox>
                                <!-- Con carga -->
                                <VBox id="vbConArchivo" visible="{= !!${app>/cargaActual} }">
                                    <!-- Ícono + nombre del archivo + fecha y registros -->
                                    <HBox id="hbArchivoNombre" alignItems="Center">
                                        <core:Icon id="icoArchivo" src="sap-icon://excel-attachment"
                                            color="Positive" size="1.5rem"/>
                                        <VBox id="vbArchivoTexto" class="sapUiSmallMarginBegin">
                                            <Title id="ttlArchivo" text="{app>/cargaActual/nombreArchivo}"
                                                level="H5" titleStyle="H6" wrapping="true"/>
                                            <Label id="lblArchivoInfo" wrapping="true"
                                                text="Cargado el {app>/cargaActual/fechaCarga} · {app>/cargaActual/totalRegistros} registros"/>
                                        </VBox>
                                    </HBox>
                                    <!-- Etiquetas de estado -->
                                    <HBox id="hbArchivoEstado" class="sapUiSmallMarginTop" wrap="Wrap">
                                        <ObjectStatus id="osArchivo" text="{app>/cargaActual/estado}"
                                            state="{app>/cargaActual/estadoState}"
                                            icon="sap-icon://sys-enter-2" inverted="true"/>
                                        <!-- Antes del proceso SAP: observados en la validación -->
                                        <ObjectStatus id="osObservados" class="sapUiSmallMarginBegin"
                                            text="{app>/cargaActual/totalObservados} observados"
                                            state="Warning" inverted="true"
                                            visible="{= !${app>/cargaActual/procesada} &amp;&amp; ${app>/cargaActual/totalObservados} > 0 }"/>
                                        <!-- Después del proceso SAP: rechazados -->
                                        <ObjectStatus id="osRechazos" class="sapUiSmallMarginBegin"
                                            text="{app>/cargaActual/totalRechazados} rechazados"
                                            state="Error" inverted="true"
                                            visible="{= !!${app>/cargaActual/procesada} &amp;&amp; ${app>/cargaActual/totalRechazados} > 0 }"/>
                                    </HBox>
                                    <Button id="btnVerDetalle" class="sapUiSmallMarginTop" width="100%"
                                        text="Ver el detalle de mis registros" icon="sap-icon://list"
                                        type="Ghost"
                                        press=".onVerDetalleActual"/>
                                </VBox>
                            </VBox>
                        </f:content>
                    </f:Card>

                    <!-- Conceptos autorizados -->
                    <f:Card id="cardConceptos">
                        <f:header>
                            <card:Header id="hdrConceptos" title="Conceptos autorizados"
                                subtitle="Habilitados por CODELCO para su institución" iconSrc="sap-icon://tag"/>
                        </f:header>
                        <f:content>
                            <VBox id="vbConceptos" width="100%">
                                <List id="lstConceptos" showSeparators="None"
                                    items="{mock>/conceptosAutorizados}"
                                    noDataText="Sin conceptos autorizados">
                                    <CustomListItem id="cliConcepto">
                                        <HBox id="hbConcepto" alignItems="Center" justifyContent="SpaceBetween"
                                            class="sapUiSmallMarginBeginEnd sapUiTinyMarginTopBottom">
                                            <HBox id="hbConceptoIzq" alignItems="Center">
                                                <ObjectStatus id="osCcnomina" text="{mock>ccnomina}"
                                                    state="Information" inverted="true"/>
                                                <Text id="txtConceptoDesc" text="{mock>descripcion}"
                                                    class="sapUiSmallMarginBegin"/>
                                            </HBox>
                                            <core:Icon id="icoConceptoOk" src="sap-icon://sys-enter-2" color="Positive"/>
                                        </HBox>
                                    </CustomListItem>
                                </List>
                                <Label id="lblConceptosNota" wrapping="true"
                                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom sapUiTinyMarginTop"
                                    text="Informar un concepto no habilitado provoca el rechazo del registro."/>
                            </VBox>
                        </f:content>
                    </f:Card>
                </l:Grid>

                <!-- ===== Resultado de la carga (visible apenas hay una carga en el período) ===== -->
                <f:Card id="cardResultado" class="sapUiSmallMarginTop sapUiTinyMarginBeginEnd"
                    visible="{= !!${app>/cargaActual} }">
                    <f:header>
                        <card:Header id="hdrResultado"
                            title="Resultado de la carga {app>/periodo/texto}"
                            subtitle="{app>/resumen/subtitulo}">
                            <card:toolbar>
                                <Button id="btnExportarResumen" text="Exportar" icon="sap-icon://download"
                                    type="Transparent" press=".onExportarResumen"/>
                            </card:toolbar>
                        </card:Header>
                    </f:header>
                    <f:content>
                        <VBox id="vbResultado" width="100%">
                            <!-- 4 KPIs compactos -->
                            <l:Grid id="gridKpis" defaultSpan="XL3 L3 M6 S12" containerQuery="true"
                                vSpacing="0.5" hSpacing="0.5" class="sapUiSmallMarginBeginEnd">
                                <VBox id="kpi1" class="pdKpi">
                                    <ObjectNumber id="onKpi1" number="{app>/resumen/informados}" class="pdKpiValor"/>
                                    <Label id="lblKpi1" text="Registros informados"/>
                                </VBox>
                                <VBox id="kpi2" class="pdKpi">
                                    <ObjectNumber id="onKpi2" number="{app>/resumen/ok}" state="Success" class="pdKpiValor"/>
                                    <Label id="lblKpi2" text="{app>/resumen/okLabel}"/>
                                </VBox>
                                <VBox id="kpi3" class="pdKpi">
                                    <ObjectNumber id="onKpi3" number="{app>/resumen/error}" state="Error" class="pdKpiValor"/>
                                    <Label id="lblKpi3" text="{app>/resumen/errorLabel}"/>
                                </VBox>
                                <VBox id="kpi4" class="pdKpi">
                                    <ObjectNumber id="onKpi4" number="$ {app>/resumen/importeCLP}" class="pdKpiValor"/>
                                    <Label id="lblKpi4"
                                        text="{= ${app>/resumen/importeUF} ? 'Importe total CLP · + ' + ${app>/resumen/importeUF} + ' UF' : 'Importe total CLP' }"/>
                                </VBox>
                            </l:Grid>

                            <!-- Motivos de rechazo -->
                            <Table id="tblMotivos" items="{app>/resumenMotivos}"
                                noDataText="Sin registros con error." class="sapUiSmallMarginTop">
                                <columns>
                                    <Column id="colMotivo"><Text id="hMotivo" text="Motivo de rechazo"/></Column>
                                    <Column id="colCant" hAlign="End" width="7rem"><Text id="hCant" text="Registros"/></Column>
                                    <Column id="colDist" width="12rem" minScreenWidth="Tablet" demandPopin="true"><Text id="hDist" text="Distribución"/></Column>
                                    <Column id="colAccion" minScreenWidth="Tablet" demandPopin="true"><Text id="hAccion" text="Qué debe corregir"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="cliMotivo">
                                        <cells>
                                            <ObjectStatus id="osMotivo" text="{app>motivo}" state="Error" icon="sap-icon://error"/>
                                            <ObjectNumber id="onCant" number="{app>cantidad}" emphasized="true"/>
                                            <ProgressIndicator id="piDist" percentValue="{app>porcentaje}"
                                                showValue="false" state="Error" height="0.5rem" displayOnly="true"/>
                                            <Text id="txtAccion" text="{app>accion}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </f:content>
                </f:Card>

                <!-- ===== Historial de cargas ===== -->
                <Table id="tblHistorial" class="sapUiMediumMarginTop"
                    items="{app>/historial}"
                    noDataText="Sin cargas anteriores.">
                    <headerToolbar>
                        <OverflowToolbar id="tbHistorial">
                            <Title id="ttlHistorial" text="Historial de cargas" level="H3"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="colHPeriodo"><Text id="hHPeriodo" text="Período"/></Column>
                        <Column id="colHArchivo" minScreenWidth="Tablet" demandPopin="true"><Text id="hHArchivo" text="Archivo"/></Column>
                        <Column id="colHFecha" minScreenWidth="Tablet" demandPopin="true"><Text id="hHFecha" text="Fecha de carga"/></Column>
                        <Column id="colHReg" hAlign="End"><Text id="hHReg" text="Registros"/></Column>
                        <Column id="colHOk" hAlign="End"><Text id="hHOk" text="Cargados"/></Column>
                        <Column id="colHRech" hAlign="End"><Text id="hHRech" text="Rechazados"/></Column>
                        <Column id="colHEstado"><Text id="hHEstado" text="Estado"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="cliHistorial" type="Navigation" press=".onVerHistorial">
                            <cells>
                                <Text id="cHPeriodo" text="{app>periodoTexto}"/>
                                <Text id="cHArchivo" text="{app>nombreArchivo}"/>
                                <Text id="cHFecha" text="{app>fechaCarga}"/>
                                <Text id="cHReg" text="{app>totalRegistros}"/>
                                <Text id="cHOk" text="{app>totalCargados}"/>
                                <Text id="cHRech" text="{app>totalRechazados}"/>
                                <ObjectStatus id="cHEstado" text="{app>estado}" state="{app>estadoState}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- ===== 🧪 Herramientas de prueba (solo mock, se quitan al conectar el CAP) ===== -->
                <OverflowToolbar id="tbPruebas" class="sapUiMediumMarginTop" style="Clear">
                    <core:Icon id="icoPruebas" src="sap-icon://lab" color="Neutral"/>
                    <Label id="lblPruebas" text="Herramientas de prueba (datos ficticios)"/>
                    <ToolbarSpacer id="tbsPruebas"/>
                    <Button id="btnSimularSAP" text="Simular proceso SAP" icon="sap-icon://process"
                        enabled="{= !!${app>/cargaActual} &amp;&amp; !${app>/cargaActual/procesada} }"
                        press=".onSimularProcesoSAP"/>
                    <Button id="btnLimpiarPruebas" text="Limpiar datos de prueba" icon="sap-icon://delete"
                        type="Transparent" press=".onLimpiarPruebas"/>
                </OverflowToolbar>

            </VBox>
        </content>
    </Page>
</mvc:View>