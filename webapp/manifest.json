{
  "_version": "1.76.0",
  "sap.app": {
    "id": "codelco.portaldescuentos",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.3"
    },
    "dataSources": {
      "mockData": {
        "uri": "mock/data.json",
        "type": "JSON"
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.142.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.unified": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "codelco.portaldescuentos.i18n.i18n"
        }
      },
      "mock": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "mockData"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "codelco.portaldescuentos.view",
        "async": true,
        "viewPath": "codelco.portaldescuentos.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": ":?query:",
          "target": ["TargetHome"]
        },
        {
          "name": "RouteCarga",
          "pattern": "carga",
          "target": ["TargetCarga"]
        },
        {
          "name": "RouteConsulta",
          "pattern": "consulta/{periodo}",
          "target": ["TargetConsulta"]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "name": "Home",
          "level": 1
        },
        "TargetCarga": {
          "id": "Carga",
          "name": "Carga",
          "level": 2
        },
        "TargetConsulta": {
          "id": "Consulta",
          "name": "Consulta",
          "level": 2
        }
      }
    },
    "rootView": {
      "viewName": "codelco.portaldescuentos.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}